{
  "animations": {
    "cry": "q.bedrock_stateful('amanita', 'cry')",
    "faint": "q.bedrock_primary('parasect', 'faint')"
  },
  "firstPersonCameraOffset": {"seat_1": [0, 0.45, 0]},
  "portraitScale": 1.8,
  "portraitTranslation": [-0.35, -0.8, 0],
  "poses": {
    "in-air": {
      "animations": ["q.bedrock('parasect', 'ride_jump')", "q.bedrock('parasect', 'ride_ground_run')"],
      "condition": "q.in_air && q.is_ridden",
      "isBattle": false,
      "poseTypes": ["STAND", "WALK"],
      "transformTicks": 2,
      "transformToTicks": 2
    },
    "run": {
      "animations": ["q.bedrock('parasect', 'ground_run')", {"animation": "q.bedrock('parasect', 'ride_ground_run')", "condition": "q.is_ridden && q.has_entity"}],
      "condition": "!q.in_air && q.is_sprinting",
      "isBattle": false,
      "poseTypes": ["STAND", "WALK"],
      "transformTicks": 5
    },
    "sleep": {
      "animations": ["q.bedrock('parasect', 'sleep')"],
      "namedAnimations": {"cry": "q.bedrock_stateful('dummy', 'cry')"},
      "poseTypes": ["SLEEP"]
    },
    "stand": {
      "animations": ["q.bedrock('parasect', 'ground_idle')"],
      "condition": "!q.in_air",
      "isBattle": false,
      "poseTypes": ["STAND", "NONE", "PORTRAIT", "PROFILE"]
    },
    "walk": {
      "animations": ["q.bedrock('parasect', 'ground_walk')", {"animation": "q.bedrock('parasect', 'ride_ground_run')", "condition": "q.is_ridden && q.has_entity"}],
      "condition": "!q.in_air && !q.is_sprinting",
      "poseTypes": ["WALK"]
    }
  },
  "profileScale": 0.8,
  "profileTranslation": [0, 0.52, 0],
  "rootBone": "parasect",
  "thirdPersonCameraOffset": {"seat_1": [0, 0.45, 0], "seat_1_reverse": [0, 0.45, 0]},
  "thirdPersonCameraOffsetNoViewBobbing": {"seat_1": [0, 0.45, 0], "seat_1_reverse": [0, 0.45, 0]}
}
